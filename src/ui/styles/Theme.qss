* {
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow, QWidget#loginScreen {
    background-color: #1b1d23;
    color: #e8eaf0;
}

QLabel {
    color: #e8eaf0;
}

QLabel#tileTitle, QLabel#panelTitle, QLabel#emptyHint, QLabel#loginNote,
QLabel#sidebarBrand, QLabel#loginSubtitle {
    color: #9aa1b2;
}

QLabel#tileTitle {
    font-size: 13px;
}

QLabel#tileValue {
    font-size: 26px;
    font-weight: 600;
    color: #f2f4fa;
}

QLabel#panelTitle {
    font-size: 15px;
    font-weight: 600;
}

QLabel#pageHeading {
    font-size: 22px;
    font-weight: 600;
}

QLabel#loginTitle {
    font-size: 26px;
    font-weight: 700;
}

QLabel#sidebarBrand {
    font-size: 16px;
    font-weight: 700;
    padding-bottom: 16px;
}

QLabel#sidebarUser {
    font-size: 12px;
    padding-top: 12px;
}

QLabel#dashboardGreeting {
    font-size: 22px;
    font-weight: 600;
}

QLabel#dashboardClock {
    font-size: 14px;
    font-weight: 600;
    color: #2dd4bf;
}

QLabel#settingsHint {
    color: #9aa1b2;
    font-size: 12px;
}

QLabel#selectorLabel {
    color: #9aa1b2;
}

QPushButton#logoutButton {
    background-color: transparent;
    border: 1px solid #323643;
    border-radius: 8px;
    color: #c3c9d6;
    padding: 8px 12px;
    text-align: left;
}

QPushButton#logoutButton:hover {
    background-color: #2b2f39;
    color: #ff8f8f;
}

QFrame#statTile, QFrame#panel {
    background-color: #24272f;
    border: 1px solid #323643;
    border-radius: 10px;
}

QFrame#sidebar {
    background-color: #202228;
    border-right: 1px solid #323643;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #c3c9d6;
    padding: 10px 12px;
    text-align: left;
}

QPushButton#navButton:hover {
    background-color: #2b2f39;
}

QPushButton#navButton:checked {
    background-color: #0f766e;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryButton {
    background-color: #14b8a6;
    border: none;
    border-radius: 8px;
    color: #ffffff;
    font-weight: 600;
    padding: 12px;
}

QPushButton#primaryButton:hover {
    background-color: #2dd4bf;
}

QPushButton:disabled {
    color: #6b7183;
}

QLineEdit#loginInput {
    background-color: #24272f;
    border: 1px solid #3a3f4d;
    border-radius: 8px;
    color: #e8eaf0;
    padding: 10px 12px;
}

QLineEdit#loginInput:focus {
    border-color: #14b8a6;
}

QCheckBox#rememberCheck {
    color: #9aa1b2;
    spacing: 8px;
}

QCheckBox#rememberCheck::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a3f4d;
    border-radius: 4px;
    background-color: #24272f;
}

QCheckBox#rememberCheck::indicator:checked {
    background-color: #14b8a6;
    border-color: #14b8a6;
}

QPushButton#linkButton {
    background-color: transparent;
    border: none;
    color: #2dd4bf;
    padding: 4px;
}

QPushButton#linkButton:hover {
    color: #5eead4;
    text-decoration: underline;
}

QComboBox {
    background-color: #24272f;
    border: 1px solid #3a3f4d;
    border-radius: 8px;
    color: #e8eaf0;
    padding: 8px 12px;
    min-width: 160px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #24272f;
    border: 1px solid #3a3f4d;
    color: #e8eaf0;
    selection-background-color: #0f766e;
}

QCheckBox {
    color: #e8eaf0;
    spacing: 8px;
}

QSplitter::handle {
    background-color: transparent;
    width: 8px;
}

QScrollBar:vertical {
    background: #1b1d23;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #3a3f4d;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* rows inside the dashboard panels (tasks, countdowns, links, files) */
QFrame#itemRow {
    background-color: #24272f;
    border: 1px solid #323643;
    border-radius: 8px;
}

QLabel#rowTitle {
    color: #e8eaf0;
    font-size: 13px;
}

QLabel#rowDetail {
    color: #9aa1b2;
    font-size: 11px;
}

QLabel#rowRemaining {
    color: #2dd4bf;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#rowButton {
    background-color: transparent;
    border: 1px solid #3a3f4d;
    border-radius: 6px;
    color: #c3c9d6;
    padding: 4px 10px;
}

QPushButton#rowButton:hover {
    background-color: #2b2f39;
    color: #e8eaf0;
}

QLineEdit#panelInput {
    background-color: #24272f;
    border: 1px solid #3a3f4d;
    border-radius: 8px;
    color: #e8eaf0;
    padding: 8px 12px;
}

QLineEdit#panelInput:focus {
    border-color: #14b8a6;
}

QComboBox#rowCombo {
    min-width: 110px;
    padding: 4px 8px;
}

QScrollArea#panelScroll, QScrollArea#panelScroll > QWidget > QWidget {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #3a3f4d;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #4a5060;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}

QLineEdit, QDateTimeEdit, QPlainTextEdit {
    background-color: #24272f;
    border: 1px solid #3a3f4d;
    border-radius: 8px;
    color: #e8eaf0;
    padding: 8px 12px;
    selection-background-color: #14b8a6;
    selection-color: #ffffff;
}

QLineEdit:focus, QDateTimeEdit:focus, QPlainTextEdit:focus {
    border-color: #14b8a6;
}

QDialog {
    background-color: #1b1d23;
}

QFormLayout QLabel {
    color: #9aa1b2;
}

QDialogButtonBox QPushButton {
    background-color: #24272f;
    border: 1px solid #3a3f4d;
    border-radius: 8px;
    color: #e8eaf0;
    padding: 8px 16px;
}

QDialogButtonBox QPushButton:hover {
    background-color: #2b2f39;
}

QDialogButtonBox QPushButton[default="true"] {
    background-color: #14b8a6;
    border: none;
    color: #ffffff;
    font-weight: 600;
}

QDialogButtonBox QPushButton[default="true"]:hover {
    background-color: #2dd4bf;
}

QToolTip {
    background-color: #2b2f39;
    color: #e8eaf0;
    border: 1px solid #3a3f4d;
    padding: 6px;
}

QMessageBox {
    background-color: #1b1d23;
}
